@model IEnumerable<CompanyVM>

<div id="app" class="row" v-cloak>
    <div class="col-xs-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title" style="display:inline-block;">All Companies</h4>
                <a asp-action="Upsert" class="btn btn-outline-primary" style="float:right;">
                    <i class="icon-plus"></i>
                </a>
            </div>

            <div class="card-body collapse in">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Name</th>
                                <th>Address</th>
                                <th>Contact</th>
                                <th>Email</th>
                                <th>Gstin</th>
                            </tr>
                            <tr>
                                <td class="p-1">
                                    <input type="text" class="form-control" placeholder="code..." v-model="search.code" />
                                </td>

                                <td class="p-1">
                                    <input type="text" class="form-control" placeholder="name..." v-model="search.name" />
                                </td>

                                <td class="p-1">
                                    <input type="text" class="form-control" placeholder="address..." v-model="search.address" />
                                </td>

                                <td class="p-1">
                                    <input type="text" class="form-control" placeholder="contact..." v-model="search.contact" />
                                </td>

                                <td class="p-1">
                                    <input type="text" class="form-control" placeholder="email..." v-model="search.email" />
                                </td>

                                <td class="p-1">
                                    <input type="text" class="form-control" placeholder="gstin..." v-model="search.gstin" />
                                </td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="item in items" :key="item.id">
                                <td>{{ item.code }}</td>
                                <td>
                                    <a :href="'/Masters/Company/Upsert/' + item.id">{{ item.name }}</a>
                                </td>
                                <td>{{ item.address }}</td>
                                <td>{{ item.contact }}</td>
                                <td>{{ item.email }}</td>
                                <td>{{ item.gstin }}</td>
                            </tr>
                            <tr v-if="items.length === 0 && !loading">
                                <td colspan="2" class="text-center text-muted py-3">No matching companies found.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Footer -->
                <div class="d-flex justify-content-between align-items-center p-2 bg-light border-top"
                     v-if="totalPages > 1">
                    <nav aria-label="Table navigation">
                        <ul class="pagination pagination-sm mb-0" style="display: flex; list-style: none; padding-left: 0;">
                            <li class="page-item" :class="{ disabled: pageNumber === 1 }">
                                <button class="page-link" @@click="changePage(1)">&laquo;</button>
                            </li>
                            <li class="page-item" :class="{ disabled: pageNumber === 1 }">
                                <button class="page-link" @@click="changePage(pageNumber - 1)">&lsaquo;</button>
                            </li>

                            <li v-for="page in totalPages" :key="page" class="page-item"
                                :class="{ active: pageNumber === page }">
                                <button class="page-link" @@click="changePage(page)">{{ page }}</button>
                            </li>

                            <li class="page-item" :class="{ disabled: pageNumber === totalPages }">
                                <button class="page-link" @@click="changePage(pageNumber + 1)">&rsaquo;</button>
                            </li>
                            <li class="page-item" :class="{ disabled: pageNumber === totalPages }">
                                <button class="page-link" @@click="changePage(totalPages)">&raquo;</button>
                            </li>
                        </ul>
                    </nav>
                    <div class="text-muted small">
                        Showing {{ (pageNumber - 1) * pageSize + 1 }} to {{ Math.min(pageNumber * pageSize, totalItems) }} of {{ totalItems }} entries
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const { createApp, onMounted } = Vue;

        createApp({
            setup() {
                const listManager = createListManager({
                    url: "/Masters/Company/GetCompaniesData",
                    pageSize: 10,
                    search: {
                        code: "",
                        name: "",
                        address: "",
                        contact: "",
                        email: "",
                        gstin: "",
                    }
                });

                onMounted(() => {
                    listManager.load();
                });

                return {
                    ...listManager
                };
            }
        }).mount("#app");
    </script>
}