@model CompanyVM

<div id="formApp">
	<section id="basic-form-layouts">
		<div class="row match-height">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<a asp-action="index">
							<i class="icon-arrow-circle-o-left"></i>
						</a>
						<h4 class="card-title ml-1" style="display:inline-block;"> Company Info</h4>

						<a asp-action="Upsert" class="btn btn-outline-primary" asp-route-id="" style="float:right;">
							<i class="icon-plus"></i>
						</a>
					</div>
					
					<partial name="_CompanySiteUpsert"/>

					<form method="post" asp-action="Upsert" enctype="multipart/form-data">
						@Html.AntiForgeryToken()
						<input type="hidden" asp-for="Id" />

						<input type="hidden" asp-for="LogoUrl" />
						<input type="hidden" asp-for="SignatureUrl" />
						<input type="hidden" asp-for="StampUrl" />

						<partial name="_ImageUploadModals" model="@("Logo")" />
						<partial name="_ImageUploadModals" model="@("Signature")" />
						<partial name="_ImageUploadModals" model="@("Stamp")" />

						<div class="card-body collapse in">
							<div class="card-block">
								<div class="form-body">
									<div class="row">
										<div class="@(Model.Id.HasValue ? "col-md-8" : "col-md-12")">
											<div class="row">
												<div class="col-md-3">
													<div class="form-group">
														<label> Code <span class="text-danger">*</span></label>
														<input asp-for="Code" class="form-control" placeholder="Code" required />
													</div>
												</div>

												<div class="col-md-9">
													<div class="form-group">
														<label> Name <span class="text-danger">*</span></label>
														<input asp-for="Name" class="form-control" placeholder="Name" required />
													</div>
												</div>
											</div>

											<div class="row">
												<div class="col-md-12">
													<div class="form-group">
														<label> Address</label>
														<textarea asp-for="Address" class="form-control" placeholder="Address"> </textarea>
													</div>
												</div>
											</div>

											<div class="row">
												<div class="col-md-3">
													<div class="form-group">
														<label> City</label>
														<input asp-for="City" class="form-control" placeholder="City" />
													</div>
												</div>

												<div class="col-md-3">
													<div class="form-group">
														<label> Pincode</label>
														<input asp-for="Pincode" class="form-control" placeholder="Pincode" />
													</div>
												</div>

												<div class="col-md-3">
													<div class="form-group">
														<label> State</label>
														<input asp-for="State" class="form-control" placeholder="State" />
													</div>
												</div>

												<div class="col-md-3">
													<div class="form-group">
														<label> Contact</label>
														<input asp-for="Contact" class="form-control" placeholder="Contact" />
													</div>
												</div>
											</div>

											<div class="row">
												<div class="col-md-3">
													<div class="form-group">
														<label> Email</label>
														<input asp-for="Email" class="form-control" placeholder="Email" />
													</div>
												</div>

												<div class="col-md-3">
													<div class="form-group">
														<label> PAN No</label>
														<input asp-for="PanNo" class="form-control" placeholder="Pan No" />
													</div>
												</div>

												<div class="col-md-3">
													<div class="form-group">
														<label> TAN No</label>
														<input asp-for="TanNo" class="form-control" placeholder="Tan No" />
													</div>
												</div>

												<div class="col-md-3">
													<div class="form-group">
														<label> CIN No</label>
														<input asp-for="CinNo" class="form-control" placeholder="CIN No" />
													</div>
												</div>
											</div>

											<div class="row">
												<div class="col-md-3">
													<div class="form-group">
														<label> GST No</label>
														<input asp-for="GstNo" class="form-control" placeholder="GST No" />
													</div>
												</div>

												<div class="col-md-3">
													<div class="form-group">
														<label> MSME No</label>
														<input asp-for="MsmeNo" class="form-control" placeholder="MSME No" />
													</div>
												</div>
											</div>

											<div class="row">
												<div class="col-md-12">
													<div class="form-group">
														<label> Remarks </label>
														<textarea asp-for="Remarks" class="form-control" placeholder="Remarks"></textarea>
													</div>
												</div>
											</div>
										</div>

										@if (Model.Id.HasValue)
										{
											<div class="col-md-4">
												<div class="card mb-4">
													<div class="card-header">
														<h4 class="card-title" style="display:inline-block;">Company Sites</h4>
														<div class="heading-elements">
															<ul class="list-inline mb-0">
																<li><a style="font-size: 20px" href="#" @@click="OpenSiteModal()"><i class="icon-plus-circled"></i></a></li>
															</ul>
														</div>
													</div>

													<div class="card-body" id="">
														<div class="table-responsive">
															<table class="table table-hover mb-0">
																<thead>
																	<tr>
																		<th width="20px">#</th>
																		<th width="30px" class="text-danger">Code</th>
																		<th class="text-danger">Site Name</th>
																	</tr>
																</thead>
																<tbody>
																	<tr v-for="(item, i) in companySites.items.sort((a, b) => a.code.localeCompare(b.code))" :key="item.id">
																		<td>{{ i + 1 }}</td>
																		<td>
																			<a href="#" @@click='OpenSiteModal(item)'>{{ item.code }}</a>
																		</td>
																		<td>{{ item.name }}</td>
																	</tr>
																	<tr v-if="companySites.length === 0 && !loading">
																		<td colspan="2" class="text-center text-muted py-3">No matching companies found.</td>
																	</tr>
																</tbody>
															</table>
														</div>
													</div>

												</div>
											</div>
										}

									</div>
								</div>

								<div class="row">
									@if (Model.Id.HasValue)
									{
										<div class="col-md-4">
											<div class="card mb-4">
												<div class="card-header">
													<h4 class="card-title" style="display:inline-block;">Logo</h4>
													<div class="heading-elements">
														<ul class="list-inline mb-0">
															<li><a style="font-size: 20px" data-toggle="modal" data-target="#logoModel"><i class="icon-plus-circled"></i></a></li>
															<li><a style="font-size: 20px" data-toggle="modal" data-target="#deleteLogoModel"><i class="icon-minus"></i></a></li>
														</ul>
													</div>
												</div>

												@if (Model.LogoUrl?.Length > 0)
												{
													<div class="card-body p-3" id="">
														<img src="@Model.LogoUrl" id="logoPreview" class="img-fluid" />
													</div>
												}

											</div>
										</div>

										<div class="col-md-4">
											<div class="card mb-4">
												<div class="card-header">
													<h4 class="card-title" style="display:inline-block;">Signature</h4>
													<div class="heading-elements">
														<ul class="list-inline mb-0">
															<li><a style="font-size: 20px" data-toggle="modal" data-target="#signatureModel"><i class="icon-plus-circled"></i></a></li>
															<li><a style="font-size: 20px" data-toggle="modal" data-target="#deleteSignatureModel"><i class="icon-minus"></i></a></li>
														</ul>
													</div>
												</div>

												@if (Model.SignatureUrl?.Length > 0)
												{
													<div class="card-body p-3" id="">
														<img src="@Model.SignatureUrl" id="signPreview" class="img-fluid" />
													</div>
												}
											</div>

										</div>

										<div class="col-md-4">
											<div class="card mb-4">
												<div class="card-header">
													<h4 class="card-title" style="display:inline-block;">Stamp</h4>
													<div class="heading-elements">
														<ul class="list-inline mb-0">
															<li><a style="font-size: 20px" data-toggle="modal" data-target="#stampModel"><i class="icon-plus-circled"></i></a></li>
															<li><a style="font-size: 20px" data-toggle="modal" data-target="#deleteStampModel"><i class="icon-minus"></i></a></li>
														</ul>
													</div>
												</div>

												@if (Model.StampUrl?.Length > 0)
												{
													<div class="card-body p-3" id="">
														<img src="@Model.StampUrl" id="stampPreview" class="img-fluid" />
													</div>
												}
											</div>

										</div>
									}
								</div>

								<div class="form-actions">
									<a asp-action="Index" class="btn btn-warning"> <i class="icon-cross2"></i> Cancel</a>

									<button type="submit" class="btn btn-primary ml-1">
										<i class="icon-check2"></i> Save
									</button>
								</div>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>
	</section>
</div>

@section Scripts {
	<script>
		const { createApp } = Vue;
		const app = createApp({
			data() {
				return {
					companyId: '@Model.Id',
					companySites: {
						items: [],
						totalItems: 0,
						totalPages: 0,
						currentPage: 1
					},
					siteForm: {
						id: '00000000-0000-0000-0000-000000000000',
						companyId: '@Model.Id',
						code: '',
						name: '',
						address: '',
						city: '',
						pincode: 0,
						contact: '',
						email: '',
						gstNo: '',
						lutNo: '',
						einvoiceUsername: '',
						ewayUsername: '',
						ewayPassword: '',
						active: 'Yes'
					}
				}
			},
			mounted() {
				if (this.companyId != null) {
					this.GetCompanySites();
				}
			},
			methods: {
				getEmptySite() {
					return {
						id: '00000000-0000-0000-0000-000000000000',
						companyId: this.companyId,
						code: '',
						name: '',
						address: '',
						city: '',
						pincode: 0,
						contact: '',
						email: '',
						gstNo: '',
						lutNo: '',
						einvoiceUsername: '',
						ewayUsername: '',
						ewayPassword: '',
						active: 'Yes'
					};
				},
				async GetCompanySites() {
					try {
						const response = await fetch(`/Masters/CompanySite/GetByCompanyId?id=${this.companyId}`); 
						if (response.ok) {
							this.companySites = await response.json();
						}
					} catch (error) {
						console.error("Error fetching sites:", error);
					}
				},

				OpenSiteModal(site = null) {
					if (site) {
						this.siteForm = { ...site };
					} else {
						this.siteForm = this.getEmptySite();
					}
					
					$('#companySiteModel').modal('show');
				},

				async UpsertCompanySite() {
					if (!this.siteForm.name.trim()) {
						alert("Site name is required.");
						return;
					}
					const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
					const url = '/Masters/CompanySite/Upsert';
					try {
						const response = await fetch(url, {
							method: 'POST',
							headers: { 
								'Content-Type': 'application/json', 
								'RequestVerificationToken': token
							},
							body: JSON.stringify(this.siteForm)
						});

						if (response.ok) {
							$('#companySiteModel').modal('hide');
							await this.GetCompanySites();
						} else {
							const errorData = await response.json();
							alert("Failed to save: " + (errorData.message || "Unknown error"));
						}
					} catch (error) {
						console.error("Error saving site:", error);
					}
				}
			},
		});

		app.mount('#formApp')
	</script>
}
