@model IEnumerable<ProductVM>

<div id="app" class="row" v-cloak>
    <div class="col-xs-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title" style="display:inline-block;">All Products</h4>
                <a asp-action="Upsert" class="btn btn-outline-primary" style="float:right;">
                    <i class="icon-plus"></i>
                </a>
            </div>

            <div class="card-body collapse in">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th style="text-align:center">Category</th>
                                <th style="text-align:center">Name</th>
                                <th style="text-align:center">Make</th>
                                <th style="text-align:center">Pack</th>
                                <th style="text-align:center">Unit</th>
                                <th style="text-align:center">Rate</th>
                                <th style="text-align:center">GST</th>
                                <th style="text-align:center">HSN</th>
                                <th style="text-align:center">MSL</th>
                                <th style="text-align:center">Active</th>
                            </tr>
                            <tr>
                                <td class="p-1">
                                    <input type="text" class="form-control" placeholder="category..." v-model="search.category" />
                                </td>

                                <td class="p-1">
                                    <input type="text" class="form-control" placeholder="name..." v-model="search.name" />
                                </td>

                                <td class="p-1">
                                    <input type="text" class="form-control" placeholder="make..." v-model="search.make" />
                                </td>

                                <td class="p-1">
                                    <input type="text" class="form-control" placeholder="pack..." v-model="search.pack" />
                                </td>

                                <td class="p-1">
                                    <input type="text" class="form-control" placeholder="unit..." v-model="search.unit" />
                                </td>
                                <td class="p-1"></td>
                                <td class="p-1"></td>
                                <td class="p-1">
                                    <input type="text" class="form-control" placeholder="hsn..." v-model="search.hsn" />
                                </td>
                                <td class="p-1"></td>
                                <td class="p-1">
                                    <select class="form-control" v-model="search.active">
                                        <option :value="-1"></option>
                                        <option :value="1">No</option>
                                        <option :value="0">Yes</option>
                                    </select>
                                </td>
                            </tr>
                        </thead>

                        <tbody>
                            <tr v-for="item in items" :key="item.id">
                                <td>{{ item.categoryName }}</td>
                                <td>
                                    <a :href="'/Masters/Product/Upsert/' + item.id">{{ item.name }}</a>
                                </td>
                                <td>{{ item.make }}</td>
                                <td>{{ item.pack }}</td>
                                <td>{{ item.unit }}</td>
                                <td>{{ item.rate }}</td>
                                <td>{{ item.gst }}</td>
                                <td>{{ item.hsn }}</td>
                                <td>{{ item.msl }}</td>
                                <td class="text-center"><span :class="item.active == 'Yes' ? 'tag tag-success' : 'tag tag-danger'">{{ item.active }}</span></td>
                            </tr>
                            <tr v-if="items.length === 0 && !loading">
                                <td colspan="10" class="text-center text-muted py-3">No matching products found.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Footer -->
                <div class="d-flex justify-content-between align-items-center p-2 bg-light border-top"
                     v-if="totalPages > 1">
                    <nav aria-label="Table navigation">
                        <ul class="pagination pagination-sm mb-0" style="display: flex; list-style: none; padding-left: 0;">
                            <li class="page-item" :class="{ disabled: pageNumber === 1 }">
                                <button class="page-link" @@click="changePage(1)">&laquo;</button>
                            </li>
                            <li class="page-item" :class="{ disabled: pageNumber === 1 }">
                                <button class="page-link" @@click="changePage(pageNumber - 1)">&lsaquo;</button>
                            </li>

                            <li v-for="page in totalPages" :key="page" class="page-item"
                                :class="{ active: pageNumber === page }">
                                <button class="page-link" @@click="changePage(page)">{{ page }}</button>
                            </li>

                            <li class="page-item" :class="{ disabled: pageNumber === totalPages }">
                                <button class="page-link" @@click="changePage(pageNumber + 1)">&rsaquo;</button>
                            </li>
                            <li class="page-item" :class="{ disabled: pageNumber === totalPages }">
                                <button class="page-link" @@click="changePage(totalPages)">&raquo;</button>
                            </li>
                        </ul>
                    </nav>
                    <div class="text-muted small">
                        Showing {{ (pageNumber - 1) * pageSize + 1 }} to {{ Math.min(pageNumber * pageSize, totalItems) }} of {{ totalItems }} entries
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const { createApp, onMounted } = Vue;

        createApp({
            setup() {
                const listManager = createListManager({
                    url: "/Masters/Product/GetProductsData",
                    pageSize: 10,
                    search: {
                        category: "",
                        name: "",
                        make: "",
                        pack: "",
                        unit: "",
                        msl: "",
                        active: "",
                    }
                });

                onMounted(() => {
                    listManager.load();
                });

                return {
                    ...listManager
                };
            }
        }).mount("#app");
    </script>
}